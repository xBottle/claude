				InRouter = PipeRouter {
					CtrlWZoom = false,
					NameSet = true,
					ViewInfo = PipeRouterInfo { Pos = { -1600, 0 } },
				},
				OptFlow = OpticalFlow {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "InRouter",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { -1480, 110 } },
				},
				TSFlow = TimeStretcher {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						SourceTime = Input {
							Value = 0,
							Expression = "Ctrl.RampOn > 0.5 and (comp.RenderStart + max(1, (Ctrl.ClipLen > 1.5 and Ctrl.ClipLen - 1 or comp.RenderEnd - comp.RenderStart)) * (function(x, T, k, a, h) local y if T < 0.5 then y = 1 - (1 - x) ^ k elseif T < 1.5 then y = x ^ k elseif T < 2.5 then if x < 0.5 then y = 0.5 * (2 * x) ^ k else y = 1 - 0.5 * (2 - 2 * x) ^ k end elseif T < 3.5 then if x < 0.5 then y = 0.5 * (1 - (1 - 2 * x) ^ k) else y = 0.5 + 0.5 * (2 * x - 1) ^ k end elseif T < 4.5 then h = math.min(0.95, math.max(0.05, h)) if x < h then y = 0.92 * (1 - (1 - x / h) ^ k) else y = 0.92 + 0.08 * (x - h) / (1 - h) end else if x < 0.5 then y = 1 - (1 - 2 * x) ^ k else y = 1 - (2 * x - 1) ^ k end end return x + (y - x) * a end)(min(1, max(0, (time - comp.RenderStart) / max(1, (Ctrl.ClipLen > 1.5 and Ctrl.ClipLen - 1 or comp.RenderEnd - comp.RenderStart)))), Ctrl.RampType, 1 + Ctrl.RampStrength * 4, Ctrl.RampAmount, Ctrl.HoldPoint)) or time",
						},
						InterpolationMode = Input { Value = 2, },
						InterpolateBetweenFrames = Input { Value = 2, },
