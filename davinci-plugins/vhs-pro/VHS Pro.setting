.95, LineJitter = 0.3, Wobble = 0.2, FrameJitter = 0.1, HeadHeight = 0.012, HeadShift = 12, Snow = 0.03, ChromaNoise = 0.12, Dropouts = 0.1, Vignette = 0.15 }, [2] = { CamOn = 1, CamShake = 0.5, CamRot = 0.4, CamTremor = 0.3, OSDOn = 1, OSDLabel = 1, Warmth = 0.3, Sat = 0.9, BlackLift = 0.06, FocusHunt = 0.25, ExpoPump = 0.3 }, [3] = { LumaBlur = 4, ChromaBlur = 16, ChromaShift = 5, Sat = 0.6, BlackLift = 0.08, LineJitter = 1.5, Wobble = 1.2, FrameJitter = 0.8, HeadHeight = 0.035, HeadShift = 45, Snow = 0.2, ChromaNoise = 0.6, Dropouts = 0.8, CreaseOn = 1, CreaseAmount = 0.6, CreaseEvery = 3, Vignette = 0.4 }, [4] = { Mode = 1, OSDOn = 1, OSDLabel = 0, LineJitter = 1, Snow = 0.1 }, [5] = { Mode = 2, OSDOn = 1, OSDLabel = 0, LineJitter = 2, Snow = 0.15, ChromaNoise = 0.4 }, [6] = { CamOn = 1, CamShake = 1.2, CamRot = 1, CamTremor = 0.7, CamWalk = 0.5, CamZoom = 0.3, FocusHunt = 0.35, ExpoPump = 0.4, OSDOn = 1, OSDLabel = 1 }, [7] = { ChromaShift = 6, Sat = 1.25, Contrast = 0.1, Wobble = 1.5, LineJitter = 1.2, CreaseOn = 1, CreaseAmount = 0.8, CreaseEvery = 2.5, Dropouts = 0.5, Vignette = 0.35 }, [8] = { Gain = 1.3, BlackLift = 0.08, Sat = 0.5, Snow = 0.25, ChromaNoise = 0.7, LumaBlur = 3.5, ChromaBlur = 14, Warmth = -0.2, Vignette = 0.45, CamOn = 1, CamShake = 0.4, CamTremor = 0.3 }, [9] = { Warmth = 0.45, Sat = 1.1, Hue = -5, Gain = 1.08, BlackLift = 0.07, Contrast = -0.1, Vignette = 0.3 }, [10] = { LumaBlur = 5, ChromaBlur = 20, ChromaShift = 7, Sat = 0.45, Hue = 8, BlackLift = 0.1, Contrast = -0.15, LineJitter = 2, Wobble = 2, FrameJitter = 1.2, HeadHeight = 0.05, HeadShift = 60, Snow = 0.3, ChromaNoise = 0.8, Dropouts = 1, CreaseOn = 1, CreaseAmount = 0.9, CreaseEvery = 2, Aspect43 = 1, Vignette = 0.55 }, [11] = { ChromaShift = 10, LineJitter = 4, Wobble = 2.5, HeadHeight = 0.06, HeadShift = 70, Dropouts = 1, CreaseOn = 1, CreaseAmount = 1, CreaseEvery = 1.2, CreaseSpeed = 1.5, Sat = 1.3 }, [12] = { Aspect43 = 1, OSDOn = 1, OSDLabel = 2, Day = 17, Month = 6, Year = 1995, Hour = 15, Minute = 40, Warmth = 0.35, Sat = 0.9, LumaBlur = 3, BlackLift = 0.06, CamOn = 1, CamShake = 0.3, CamTremor = 0.2, Vignette = 0.35 } }\nlocal function fusionDir()  -- macOS, Windows или Linux\n  local list, appdata, home = {}, os.getenv(\"APPDATA\"), os.getenv(\"HOME\") or \"\"\n  if appdata and appdata ~= \"\" then\n    list[#list + 1] = (appdata:gsub(\"\\\\\", \"/\")) .. \"/Blackmagic Design/DaVinci Resolve/Support/Fusion/\"\n  end\n  if home ~= \"\" then\n    list[#list + 1] = home .. \"/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/\"\n    list[#list + 1] = home .. \"/.local/share/DaVinciResolve/Fusion/\"\n  end\n  for _, dir in ipairs(list) do\n    if bmd.fileexists(dir .. \"Templates\") then return dir end\n  end\n  return list[1] or \"\"\nend\nlocal FU = fusionDir()\nlocal PRESET_DIR = FU .. \"VHS Pro User Presets/\"\nlocal TEMPLATE = FU .. \"Templates/Edit/Effects/STORYVERSE/VHS/VHS Pro.setting\"\nlocal NAMES = { [0] = \"Домашняя кассета\", [1] = \"Чистый VHS\", [2] = \"Хоум-видео 90-х\", [3] = \"Затёртая кассета\", [4] = \"Пауза\", [5] = \"Перемотка\", [6] = \"Камкордер с рук\", [7] = \"Музыкальный клип\", [8] = \"Ночная съёмка\", [9] = \"Тёплое лето\", [10] = \"Кассета из подвала\", [11] = \"Глитч-кассета\", [12] = \"Свадьба 1995\" }\nlocal C = tool.Composition or comp\nlocal function say(title, text)\n  if C then C:AskUser(title, { { \"Info\", \"Text\", Name = \"\", Default = text, Lines = 3, Wrap = true } }) else print(text) end\nend\nlocal function applyTable(t)\n  if C then pcall(function() C:Lock() end); pcall(function() C:StartUndo(\"VHS Pro\") end) end\n  for _, k in ipairs(IDS) do\n    local v = t[k]\n    if type(v) == \"number\" then pcall(function() tool:SetInput(k, v) end) end\n  end\n  if C then pcall(function() C:EndUndo(true) end); pcall(function() C:Unlock() end) end\nend\nlocal function current()\n  local t = {}\n  for _, k in ipairs(IDS) do t[k] = tool:GetInput(k) end\n  return t\nend\nlocal function cleanName(s)\n  s = tostring(s or \"\"):gsub(\"[/\\\\:%*%?\\\"<>|]\", \"_\"):gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\")\n  return s\nend\nlocal function listOwn()\n  local names = {}\n  for _, f in ipairs(bmd.readdir(PRESET_DIR .. \"*.vhspreset\") or {}) do\n    if type(f) == \"table\" and f.Name and not f.IsDir then\n      names[#names + 1] = (f.Name:gsub(\"%.vhspreset$\", \"\"))\n    end\n  end\n  table.sort(names)\n  return names\nend\n-- rewrite the installed VHS Pro template so its \"Пресет\" list = built-in + own presets\nlocal function rebuildTemplate()\n  local src = bmd.readfile(TEMPLATE)\n  if type(src) ~= \"table\" then return false end\n  local grp\n  for _, v in pairs(src.Tools) do if type(v) == \"table\" and v.Tools then grp = v end end\n  if not grp then return false end\n  local ucs = grp.Tools.Ctrl.UserControls\n  local combo, apply = ucs.PresetSel, ucs.BtnApply\n  if not combo or not apply then return false end\n  local own = listOwn()\n  for i = #combo, 1, -1 do combo[i] = nil end\n  for i = 0, #NAMES do combo[#combo + 1] = { CCS_AddString = NAMES[i] } end\n  local quoted = {}\n  for _, n in ipairs(own) do\n    combo[#combo + 1] = { CCS_AddString = \"★ \" .. n }\n    quoted[#quoted + 1] = string.format(\"%q\", n)\n  end\n  combo.INP_MaxScale = #combo - 1\n  combo.INP_MaxAllowed = #combo - 1\n  local key = \"local USER_\" .. \"PRESETS = \"  -- split so this line never matches itself\n  local newList = key .. \"{ \" .. table.concat(quoted, \", \") .. \" }\"\n  apply.BTNCS_Execute = apply.BTNCS_Execute:gsub(key .. \"%b{}\", function() return newList end, 1)\n  return bmd.writefile(TEMPLATE, src) ~= false\nend\nlocal names = listOwn()\nif #names == 0 then say(\"VHS Pro\", \"Своих пресетов пока нет. Сначала нажми «Сохранить мой пресет».\") return end\nlocal r = C:AskUser(\"Загрузить мой пресет\", { { \"Preset\", \"Dropdown\", Name = \"Пресет\", Options = names } })\nif not r then return end\nlocal t = bmd.readfile(PRESET_DIR .. names[(r.Preset or 0) + 1] .. \".vhspreset\")\nif type(t) == \"table\" then applyTable(t) else say(\"VHS Pro\", \"Не удалось прочитать пресет.\") end\n", ICD_Width = 0.5 },
						BtnDelete = { LINKS_Name = "Удалить мой пресет", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INPID_InputControl = "ButtonControl", INP_Integer = false, INP_External = false, BTNCS_Execute = "local IDS = { \"GlobalMix\", \"ScaleRes\", \"LumaBlur\", \"ChromaBlur\", \"ChromaShift\", \"Sharpen\", \"Sat\", \"Hue\", \"Warmth\", \"Gain\", \"BlackLift\", \"Contrast\", \"TrackOn\", \"LineJitter\", \"Wobble\", \"WobbleSpeed\", \"FrameJitter\", \"HeadOn\", \"HeadHeight\", \"HeadShift\", \"HeadNoise\", \"NoiseOn\", \"Snow\", \"ChromaNoise\", \"Dropouts\", \"CreaseOn\", \"CreaseAmount\", \"CreaseHeight\", \"CreaseSpeed\", \"CreaseEvery\", \"Mode\", \"ModeAmount\", \"CamOn\", \"CamShake\", \"CamRot\", \"CamTremor\", \"CamWalk\", \"CamZoom\", \"CamSpeed\", \"CamFill\", \"FocusHunt\", \"ExpoPump\", \"OSDOn\", \"OSDLabel\", \"DateFormat\", \"Day\", \"Month\", \"Year\", \"Hour\", \"Minute\", \"Second\", \"Clock12\", \"ClockRun\", \"OSDSize\", \"OSDMargin\", \"OSDOpacity\", \"Aspect43\", \"Vignette\" }\nlocal DEF = { GlobalMix = 1, ScaleRes = 1, LumaBlur = 2.5, ChromaBlur = 9, ChromaShift = 3, Sharpen = 0.6, Sat = 0.85, Hue = 0, Warmth = 0.1, Gain = 1, BlackLift = 0.04, Contrast = -0.05, TrackOn = 1, LineJitter = 0.6, Wobble = 0.5, WobbleSpeed = 1, FrameJitter = 0.3, HeadOn = 1, HeadHeight = 0.02, HeadShift = 25, HeadNoise = 0.6, NoiseOn = 1, Snow = 0.06, ChromaNoise = 0.25, Dropouts = 0.3, CreaseOn = 0, CreaseAmount = 0.5, CreaseHeight = 0.06, CreaseSpeed = 0.6, CreaseEvery = 4, Mode = 0, ModeAmount = 1, CamOn = 0, CamShake = 0.6, CamRot = 0.5, CamTremor = 0.4, CamWalk = 0, CamZoom = 0, CamSpeed = 1, CamFill = 1, FocusHunt = 0, ExpoPump = 0, OSDOn = 0, OSDLabel = 0, DateFormat = 0, Day = 26, Month = 9, Year = 1996, Hour = 22, Minute = 24, Second = 37, Clock12 = 1, ClockRun = 1, OSDSize = 1, OSDMargin = 0.06, OSDOpacity = 0.9, Aspect43 = 0, Vignette = 0.25 }\nlocal PRESETS = { [0] = {}, [1] = { LumaBlur = 1.5, ChromaBlur = 5, ChromaShift = 2, Sharpen = 0.4, Sat = 0.95, LineJitter = 0.3, Wobble = 0.2, FrameJitter = 0.1, HeadHeight = 0.012, HeadShift = 12, Snow = 0.03, ChromaNoise = 0.12, Dropouts = 0.1, Vignette = 0.15 }, [2] = { CamOn = 1, CamShake = 0.5, CamRot = 0.4, CamTremor = 0.3, OSDOn = 1, OSDLabel = 1, Warmth = 0.3, Sat = 0.9, BlackLift = 0.06, FocusHunt = 0.25, ExpoPump = 0.3 }, [3] = { LumaBlur = 4, ChromaBlur = 16, ChromaShift = 5, Sat = 0.6, BlackLift = 0.08, LineJitter = 1.5, Wobble = 1.2, FrameJitter = 0.8, HeadHeight = 0.035, HeadShift = 45, Snow = 0.2, ChromaNoise = 0.6, Dropouts = 0.8, CreaseOn = 1, CreaseAmount = 0.6, CreaseEvery = 3, Vignette = 0.4 }, [4] = { Mode = 1, OSDOn = 1, OSDLabel = 0, LineJitter = 1, Snow = 0.1 }, [5] = { Mode = 2, OSDOn = 1, OSDLabel = 0, LineJitter = 2, Snow = 0.15, ChromaNoise = 0.4 }, [6] = { CamOn = 1, CamShake = 1.2, CamRot = 1, CamTremor = 0.7, CamWalk = 0.5, CamZoom = 0.3, FocusHunt = 0.35, ExpoPump = 0.4, OSDOn = 1, OSDLabel = 1 }, [7] = { ChromaShift = 6, Sat = 1.25, Contrast = 0.1, Wobble = 1.5, LineJitter = 1.2, CreaseOn = 1, CreaseAmount = 0.8, CreaseEvery = 2.5, Dropouts = 0.5, Vignette = 0.35 }, [8] = { Gain = 1.3, BlackLift = 0.08, Sat = 0.5, Snow = 0.25, ChromaNoise = 0.7, LumaBlur = 3.5, ChromaBlur = 14, Warmth = -0.2, Vignette = 0.45, CamOn = 1, CamShake = 0.4, CamTremor = 0.3 }, [9] = { Warmth = 0.45, Sat = 1.1, Hue = -5, Gain = 1.08, BlackLift = 0.07, Contrast = -0.1, Vignette = 0.3 }, [10] = { LumaBlur = 5, ChromaBlur = 20, ChromaShift = 7, Sat = 0.45, Hue = 8, BlackLift = 0.1, Contrast = -0.15, LineJitter = 2, Wobble = 2, FrameJitter = 1.2, HeadHeight = 0.05, HeadShift = 60, Snow = 0.3, ChromaNoise = 0.8, Dropouts = 1, CreaseOn = 1, CreaseAmount = 0.9, CreaseEvery = 2, Aspect43 = 1, Vignette = 0.55 }, [11] = { ChromaShift = 10, LineJitter = 4, Wobble = 2.5, HeadHeight = 0.06, HeadShift = 70, Dropouts = 1, CreaseOn = 1, CreaseAmount = 1, CreaseEvery = 1.2, CreaseSpeed = 1.5, Sat = 1.3 }, [12] = { Aspect43 = 1, OSDOn = 1, OSDLabel = 2, Day = 17, Month = 6, Year = 1995, Hour = 15, Minute = 40, Warmth = 0.35, Sat = 0.9, LumaBlur = 3, BlackLift = 0.06, CamOn = 1, CamShake = 0.3, CamTremor = 0.2, Vignette = 0.35 } }\nlocal function fusionDir()  -- macOS, Windows или Linux\n  local list, appdata, home = {}, os.getenv(\"APPDATA\"), os.getenv(\"HOME\") or \"\"\n  if appdata and appdata ~= \"\" then\n    list[#list + 1] = (appdata:gsub(\"\\\\\", \"/\")) .. \"/Blackmagic Design/DaVinci Resolve/Support/Fusion/\"\n  end\n  if home ~= \"\" then\n    list[#list + 1] = home .. \"/Library/Application Support/Blackmagic Design/DaVinci Resolve/Fusion/\"\n    list[#list + 1] = home .. \"/.local/share/DaVinciResolve/Fusion/\"\n  end\n  for _, dir in ipairs(list) do\n    if bmd.fileexists(dir .. \"Templates\") then return dir end\n  end\n  return list[1] or \"\"\nend\nlocal FU = fusionDir()\nlocal PRESET_DIR = FU .. \"VHS Pro User Presets/\"\nlocal TEMPLATE = FU .. \"Templates/Edit/Effects/STORYVERSE/VHS/VHS Pro.setting\"\nlocal NAMES = { [0] = \"Домашняя кассета\", [1] = \"Чистый VHS\", [2] = \"Хоум-видео 90-х\", [3] = \"Затёртая кассета\", [4] = \"Пауза\", [5] = \"Перемотка\", [6] = \"Камкордер с рук\", [7] = \"Музыкальный клип\", [8] = \"Ночная съёмка\", [9] = \"Тёплое лето\", [10] = \"Кассета из подвала\", [11] = \"Глитч-кассета\", [12] = \"Свадьба 1995\" }\nlocal C = tool.Composition or comp\nlocal function say(title, text)\n  if C then C:AskUser(title, { { \"Info\", \"Text\", Name = \"\", Default = text, Lines = 3, Wrap = true } }) else print(text) end\nend\nlocal function applyTable(t)\n  if C then pcall(function() C:Lock() end); pcall(function() C:StartUndo(\"VHS Pro\") end) end\n  for _, k in ipairs(IDS) do\n    local v = t[k]\n    if type(v) == \"number\" then pcall(function() tool:SetInput(k, v) end) end\n  end\n  if C then pcall(function() C:EndUndo(true) end); pcall(function() C:Unlock() end) end\nend\nlocal function current()\n  local t = {}\n  for _, k in ipairs(IDS) do t[k] = tool:GetInput(k) end\n  return t\nend\nlocal function cleanName(s)\n  s = tostring(s or \"\"):gsub(\"[/\\\\:%*%?\\\"<>|]\", \"_\"):gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\")\n  return s\nend\nlocal function listOwn()\n  local names = {}\n  for _, f in ipairs(bmd.readdir(PRESET_DIR .. \"*.vhspreset\") or {}) do\n    if type(f) == \"table\" and f.Name and not f.IsDir then\n      names[#names + 1] = (f.Name:gsub(\"%.vhspreset$\", \"\"))\n    end\n  end\n  table.sort(names)\n  return names\nend\n-- rewrite the installed VHS Pro template so its \"Пресет\" list = built-in + own presets\nlocal function rebuildTemplate()\n  local src = bmd.readfile(TEMPLATE)\n  if type(src) ~= \"table\" then return false end\n  local grp\n  for _, v in pairs(src.Tools) do if type(v) == \"table\" and v.Tools then grp = v end end\n  if not grp then return false end\n  local ucs = grp.Tools.Ctrl.UserControls\n  local combo, apply = ucs.PresetSel, ucs.BtnApply\n  if not combo or not apply then return false end\n  local own = listOwn()\n  for i = #combo, 1, -1 do combo[i] = nil end\n  for i = 0, #NAMES do combo[#combo + 1] = { CCS_AddString = NAMES[i] } end\n  local quoted = {}\n  for _, n in ipairs(own) do\n    combo[#combo + 1] = { CCS_AddString = \"★ \" .. n }\n    quoted[#quoted + 1] = string.format(\"%q\", n)\n  end\n  combo.INP_MaxScale = #combo - 1\n  combo.INP_MaxAllowed = #combo - 1\n  local key = \"local USER_\" .. \"PRESETS = \"  -- split so this line never matches itself\n  local newList = key .. \"{ \" .. table.concat(quoted, \", \") .. \" }\"\n  apply.BTNCS_Execute = apply.BTNCS_Execute:gsub(key .. \"%b{}\", function() return newList end, 1)\n  return bmd.writefile(TEMPLATE, src) ~= false\nend\nlocal names = listOwn()\nif #names == 0 then say(\"VHS Pro\", \"Своих пресетов пока нет.\") return end\nlocal r = C:AskUser(\"Удалить мой пресет\", { { \"Preset\", \"Dropdown\", Name = \"Какой удалить\", Options = names } })\nif not r then return end\nlocal name = names[(r.Preset or 0) + 1]\nos.remove(PRESET_DIR .. name .. \".vhspreset\")\nrebuildTemplate()\nsay(\"VHS Pro\", \"Пресет «\" .. name .. \"» удалён.\")\n", ICD_Width = 0.5 },
						BtnReset = { LINKS_Name = "Сбросить всё", LINKID_DataType = "Number", ICS_ControlPage = "Controls", INPID_InputControl = "ButtonControl", INP_Integer = false, INP_External = false, BTNCS_Execute = "local IDS = { \"GlobalMix\", \"ScaleRes\", \"LumaBlur\", \"ChromaBlur\", \"ChromaShift\", \"Sharpen\", \"Sat\", \"Hue\", \"Warmth\", \"Gain\", \"BlackLift\", \"Contrast\", \"TrackOn\", \"LineJitter\", \"Wobble\", \"WobbleSpeed\", \"FrameJitter\", \"HeadOn\", \"HeadHeight\", \"HeadShift\", \"HeadNoise\", \"NoiseOn\", \"Snow\", \"ChromaNoise\", \"Dropouts\", \"CreaseOn\", \"CreaseAmount\", \"CreaseHeight\", \"CreaseSpeed\", \"CreaseEvery\", \"Mode\", \"ModeAmount\", \"CamOn\", \"CamShake\", \"CamRot\", \"CamTremor\", \"CamWalk\", \"CamZoom\", \"CamSpeed\", \"CamFill\", \"FocusHunt\", \"ExpoPump\", \"OSDOn\", \"OSDLabel\", \"DateFormat\", \"Day\", \"Month\", \"Year\", \"Hour\", \"Minute\", \"Second\", \"Clock12\", \"ClockRun\", \"OSDSize\", \"OSDMargin\", \"OSDOpacity\", \"Aspect43\", \"Vignette\" }\nlocal DEF = { GlobalMix = 1, ScaleRes = 1, LumaBlur = 2.5, ChromaBlur = 9, ChromaShift = 3, Sharpen = 0.6, Sat = 0.85, Hue = 0, Warmth = 0.1, Gain = 1, BlackLift = 0.04, Contrast = -0.05, TrackOn = 1, LineJitter = 0.6, Wobble = 0.5, WobbleSpeed = 1, FrameJitter = 0.3, HeadOn = 1, HeadHeight = 0.02, HeadShift = 25, HeadNoise = 0.6, NoiseOn = 1, Snow = 0.06, ChromaNoise = 0.25, Dropouts = 0.3, CreaseOn = 0, CreaseAmount = 0.5, CreaseHeight = 0.06, CreaseSpeed = 0.6, CreaseEvery = 4, Mode = 0, ModeAmount = 1, CamOn = 0, CamShake = 0.6, CamRot = 0.5, CamTremor = 0.4, CamWalk = 0, CamZoom = 0, CamSpeed = 1, CamFill = 1, FocusHunt = 0, ExpoPump = 0, OSDOn = 0, OSDLabel = 0, DateFormat = 0, Day = 26, Month = 9, Year = 1996, Hour = 22, Minute = 24, Second = 37, Clock12 = 1, ClockRun = 1, OSDSize = 1, OSDMargin = 0.06, OSDOpacity = 0.9, Aspect43 = 0, Vignette = 0.25 }\nlocal PRESETS = { [0] = {}, [1] = { LumaBlur = 1.5, ChromaBlur = 5, ChromaShift = 2, Sharpen = 0.4, Sat = 0.95, Li